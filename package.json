{
  "name": "spur-ai-live-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "pnpm -r --filter './packages/*' build && pnpm -r --parallel --filter api --filter web dev",
    "dev:api": "pnpm -r --filter './packages/*' build && pnpm --filter api dev",
    "dev:web": "pnpm -r --filter './packages/*' build && pnpm --filter web dev",
    "build": "pnpm -r --filter './packages/*' --filter api --filter web build",
    "start": "pnpm -r --filter './packages/*' --filter web start",
    "test": "pnpm -r --filter './packages/*' build && pnpm -r --filter './packages/*' --filter api --filter web test",
    "typecheck": "pnpm -r --filter './packages/*' --filter api --filter web typecheck",
    "lint": "pnpm -r --filter './packages/*' --filter api --filter web lint",
    "db:generate": "pnpm --filter @spur/db db:generate",
    "db:migrate": "pnpm --filter @spur/db db:migrate",
    "db:seed": "pnpm --filter @spur/db db:seed"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
