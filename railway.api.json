{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @spur/shared build && pnpm --filter @spur/db build && pnpm --filter api build",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/db/**",
      "/packages/shared/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/.node-version",
      "/.npmrc"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
