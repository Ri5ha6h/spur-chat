{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @spur/shared build && pnpm --filter web build",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/shared/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/.node-version",
      "/.npmrc"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --filter web start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30
  }
}
