{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @spur/shared build && pnpm --filter @spur/db build && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @spur/shared build && pnpm --filter @spur/db build && vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.7.5",
    "@spur/db": "workspace:*",
    "@spur/shared": "workspace:*",
    "@tanstack/ai": "^0.26.1",
    "@tanstack/ai-openai": "^0.12.1",
    "@tanstack/ai-openrouter": "^0.12.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "hono": "^4.12.23",
    "pg": "^8.16.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
